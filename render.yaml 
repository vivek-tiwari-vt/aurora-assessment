services:
  - type: web
    name: aurora-qa-system
    runtime: docker
    plan: free
    numInstances: 1
    
    # Build configuration
    dockerfilePath: ./Dockerfile
    
    # Environment
    envVars:
      - key: LOG_LEVEL
        value: INFO
      
      # Add your Gemini API keys here
      # Format: key1,key2,key3
      - key: GEMINI_API_KEYS
        scope: RUN
        sync: false
    
    # Health check
    healthCheckPath: /api
    healthCheckInterval: 30
    
    # Auto-deploy on git push
    autoDeploy: true
    
    # Scaling
    maxInstanceCount: 1
    minInstanceCount: 1

