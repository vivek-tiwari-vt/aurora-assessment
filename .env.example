# Gemini API Configuration
# Get free API keys from: https://ai.google.dev
# You can add multiple keys - they'll rotate automatically

# Option 1: Comma-separated keys (recommended)
GEMINI_API_KEYS=your-first-api-key,your-second-api-key,your-third-api-key

# Option 2: Numbered keys (alternative)
# GEMINI_API_KEY_1=your-first-api-key
# GEMINI_API_KEY_2=your-second-api-key
# GEMINI_API_KEY_3=your-third-api-key

# Logging
LOG_LEVEL=INFO

# Port Configuration (for Render.com, use PORT env var)
PORT=8000

# Aurora API Endpoint (usually doesn't need to change)
AURORA_API_URL=https://november7-730026606190.europe-west1.run.app/messages

# Optional: Model Configuration
# GEMINI_MODEL=gemini-pro

# Optional: Temperature for responses (0.0-1.0)
# TEMPERATURE=0.3